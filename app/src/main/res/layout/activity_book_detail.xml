<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
      Standard app bar. The toolbar takes the status-bar inset and the content takes the
      navigation-bar inset, both applied in code through BaseActivity.
    -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:navigationIconTint="?attr/colorOnSurfaceVariant"
            app:title="@string/title_book_detail" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/rootScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"    android:layout_weight="1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageCover"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="fitCenter"
                android:contentDescription="Book cover"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginBottom="32dp"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmallEmphasized"
                app:layout_constraintTop_toBottomOf="@id/imageCover"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp" />

            <TextView
                android:id="@+id/textAuthor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/m3_title_medium"
                app:layout_constraintTop_toBottomOf="@id/textTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="16dp" />

            <TextView
                android:id="@+id/textChapters"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/m3_body_medium"
                app:layout_constraintTop_toBottomOf="@id/textAuthor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="16dp" />

            <TextView
                android:id="@+id/textStoryStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Status: Reading saved metadata…"
                android:textSize="@dimen/m3_body_medium"
                android:textIsSelectable="true"
                app:layout_constraintTop_toBottomOf="@id/textChapters"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp" />

            <TextView
                android:id="@+id/textStoryUpdated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Story updated: Reading saved metadata…"
                android:textSize="@dimen/m3_body_medium"
                android:textIsSelectable="true"
                app:layout_constraintTop_toBottomOf="@id/textStoryStatus"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="16dp" />

            <TextView
                android:id="@+id/textUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/m3_body_small"
                app:layout_constraintTop_toBottomOf="@id/textStoryUpdated"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="16dp" />

            <TextView
                android:id="@+id/textPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/m3_body_small"
                app:layout_constraintTop_toBottomOf="@id/textUrl"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="16dp" />

            <TextView
                android:id="@+id/textSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/m3_body_small"
                app:layout_constraintTop_toBottomOf="@id/textPath"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="16dp" />

            <TextView
                android:id="@+id/textModified"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/m3_body_small"
                app:layout_constraintTop_toBottomOf="@id/textSize"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonOpen"
                android:text="Open"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/textModified"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                style="@style/Widget.Material3Expressive.Button.ElevatedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonUpdate"
                android:text="Update"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/buttonOpen"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                style="@style/Widget.Material3Expressive.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonForce"
                android:text="Force Download"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/buttonUpdate"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                style="@style/Widget.Material3Expressive.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonUrl"
                android:text="Open Story URL"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/buttonForce"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                style="@style/Widget.Material3Expressive.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonShare"
                android:text="Share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/buttonUrl"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                style="@style/Widget.Material3Expressive.Button.TextButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDelete"
                android:text="Delete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/buttonShare"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                style="@style/Widget.Material3Expressive.Button.TextButton"
                android:textColor="?attr/colorError" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditMetadata"
                android:text="Edit Metadata"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/buttonDelete"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                style="@style/Widget.Material3Expressive.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPreviewOnline"
                android:text="Preview Online Metadata"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/buttonEditMetadata"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                style="@style/Widget.Material3Expressive.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRefreshStory"
                android:text="Refresh from story site"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/buttonPreviewOnline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                style="@style/Widget.Material3Expressive.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonReplaceCover"
                android:text="Replace Cover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/buttonRefreshStory"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                style="@style/Widget.Material3Expressive.Button.OutlinedButton" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>

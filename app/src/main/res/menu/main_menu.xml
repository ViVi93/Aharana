        android:title="Refresh All"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_diagnostics"
        android:title="Diagnostics"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_queue"
        android:title="Queue"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_sort"
